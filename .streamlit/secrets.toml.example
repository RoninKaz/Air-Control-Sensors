# ПРИМЕР файла с ключами.
# 1. Скопируйте этот файл в той же папке и назовите копию: secrets.toml
# 2. Вставьте свои ключи вместо текста в кавычках.
# 3. Перезапустите: python -m streamlit run app.py
# Файл secrets.toml в GitHub НЕ загружается — ключи остаются только у вас.

# Ключ OpenAI (команда ИИ). Начинается с sk-
AI_API_KEY = "sk-ваш_ключ_OpenAI"

# Ключ реальных датчиков aqicn.org (бесплатно: aqicn.org/data-platform/token)
AQICN_TOKEN = "ваш_ключ_aqicn"
